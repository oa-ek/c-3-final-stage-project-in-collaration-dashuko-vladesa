@model IEnumerable<LogisticsGroup.Web.Models.UserViewModel>

@{
    ViewData["Title"] = "Керування персоналом";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-dark fw-bold"><i class="bi bi-people-fill text-primary"></i> Керування персоналом</h2>
    <a asp-action="CreateStaff" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
        <i class="bi bi-person-plus"></i> Додати співробітника
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Email</th>
                        <th>Посада</th>
                        <th>Статус</th>
                        <th class="text-end pe-4">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                            <tr>
                                <td class="ps-4 fw-bold">@user.Email</td>
                                <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-dark">Адміністратор</span>
                                }
                                else if (user.Role == "Logistician")
                                {
                                    <span class="badge bg-primary">Логіст</span>
                                }
                                else if (user.Role == "Driver")
                                {
                                    <span class="badge bg-info text-dark">Водій</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@user.Role</span>
                                }
                                </td>
                                <td>
                                @if (user.IsLockedOut)
                                {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3">
                                                <i class="bi bi-lock-fill"></i> Звільнений
                                            </span>
                                }
                                else
                                {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3">
                                                <i class="bi bi-unlock-fill"></i> Активний
                                            </span>
                                }
                                </td>
                                <td class="text-end pe-4">
                                @if (!user.IsCurrentUser)
                                {
                                            <form asp-action="ToggleLock" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsLockedOut)
                                        {
                                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm">
                                                            <i class="bi bi-arrow-counterclockwise"></i> Відновити
                                                        </button>
                                        }
                                        else
                                        {
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" 
                                                                onclick="return confirm('Ви впевнені, що хочете звільнити цього співробітника? Він втратить доступ до системи.');">
                                                            <i class="bi bi-person-x-fill"></i> Звільнити
                                                        </button>
                                        }
                                            </form>
                                }
                                else
                                {
                                            <span class="text-muted small fw-bold"><i class="bi bi-shield-lock"></i> Це ви</span>
                                }
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>