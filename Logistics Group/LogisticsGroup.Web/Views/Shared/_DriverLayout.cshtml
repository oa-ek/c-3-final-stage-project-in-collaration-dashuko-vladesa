<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Logistics Driver</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
            body {
                background-color: #f8f9fa; /* Світло-сірий фон, як у додатках */
                -webkit-tap-highlight-color: transparent; /* Прибирає синє моргання при кліку на телефоні */
            }
        
            /* Мобільна шапка */
            .driver-header {
                background-color: #ed3237; /* Фірмовий червоний */
                color: white;
                padding: 15px 20px;
                border-bottom-left-radius: 20px;
                border-bottom-right-radius: 20px;
                box-shadow: 0 4px 10px rgba(237, 50, 55, 0.2);
            }
    </style>
</head>
<body>
    <header class="driver-header d-flex justify-content-between align-items-center">
        <div class="fw-bold fs-5">
            <i class="bi bi-box-seam-fill me-1"></i> LogisticsGroup
        </div>
        
        <form id="logoutForm" class="form-inline m-0" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-sm btn-light rounded-pill text-danger fw-bold shadow-sm px-3">
                <i class="bi bi-box-arrow-right"></i> Вийти
            </button>
        </form>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>