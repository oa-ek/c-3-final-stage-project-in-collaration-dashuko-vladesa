@{
    ViewData["Title"] = "Головна";
}

<style>
    /* Преміальний червоний градієнт для шапки сайту */
    .hero-section {
        background: linear-gradient(135deg, #ed3237 0%, #a61216 100%);
        color: white;
        padding: 5rem 0 10rem 0; /* Збільшили нижній відступ, щоб вліз пошук */
        border-radius: 0 0 40px 40px;
        box-shadow: 0 10px 30px rgba(237, 50, 55, 0.2);
        margin-top: -16px;
    }

    /* Ефект "наповзання" карток на червоний фон */
    .overlap-cards {
        margin-top: -6rem; /* Трохи підняли, щоб гарно лягало під результат пошуку */
        position: relative;
        z-index: 10;
    }

    /* Сучасні картки */
    .hover-card {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: none;
        border-radius: 20px;
        background: #ffffff;
    }

    .hover-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08) !important;
    }

    /* Стильні квадрати для іконок */
    .icon-wrapper {
        width: 80px;
        height: 80px;
        background-color: rgba(237, 50, 55, 0.08);
        color: #ed3237;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem auto;
        transition: all 0.4s ease;
    }

    .hover-card:hover .icon-wrapper {
        background-color: #ed3237;
        color: white;
        transform: scale(1.1) rotate(5deg);
    }
</style>

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bolder mb-3">Logistics Group</h1>
        <p class="lead mx-auto mb-5" style="max-width: 600px; color: rgba(255,255,255,0.85);">
            Сучасна система управління логістичними процесами, автопарком та персоналом рівня Enterprise.
        </p>

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <form asp-action="Index" method="get" class="d-flex bg-white p-2 rounded-pill shadow-lg">
                    <input type="text" name="ttn" class="form-control border-0 rounded-pill px-4 fs-5" 
                           placeholder="Введіть номер ТТН..." value="@ViewBag.SearchedTTN" required 
                           style="box-shadow: none; outline: none;">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold fs-5">Відстежити</button>
                </form>
            </div>
        </div>

        @if (ViewBag.SearchedTTN != null)
        {
                <div class="row justify-content-center mt-4">
                    <div class="col-md-8 col-lg-6">
                        <div class="card border-0 shadow rounded-4 text-dark text-start">
                            <div class="card-body p-4">
                            @if (ViewBag.Parcel != null)
                            {
                                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                                            <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-box-seam me-2"></i>Посилку знайдено!</h5>
                                            <span class="badge bg-danger rounded-pill fs-6">@ViewBag.Parcel.Status</span>
                                        </div>

                                        <div class="row text-center mb-3">
                                            <div class="col-5">
                                                <p class="text-muted mb-1 small">Відправлення</p>
                                                <h6 class="fw-bold mb-0">@ViewBag.Parcel.SenderBranch.City.Name</h6>
                                                <small class="text-muted">Відділення №@ViewBag.Parcel.SenderBranch.Number</small>
                                            </div>
                                            <div class="col-2 d-flex align-items-center justify-content-center text-danger">
                                                <i class="bi bi-arrow-right-circle-fill fs-3"></i>
                                            </div>
                                            <div class="col-5">
                                                <p class="text-muted mb-1 small">Призначення</p>
                                                <h6 class="fw-bold mb-0">@ViewBag.Parcel.ReceiverBranch.City.Name</h6>
                                                <small class="text-muted">Відділення №@ViewBag.Parcel.ReceiverBranch.Number</small>
                                            </div>
                                        </div>

                                        <div class="bg-light p-3 rounded-3 text-center">
                                            <span class="text-muted">ТТН:</span> <strong>@ViewBag.Parcel.Barcode</strong> | 
                                            <span class="text-muted">Вага:</span> <strong>@ViewBag.Parcel.Weight кг</strong>
                                        </div>
                            }
                            else
                            {
                                        <div class="text-center py-3">
                                            <i class="bi bi-search text-muted fs-1 mb-2"></i>
                                            <h5 class="fw-bold">Посилку не знайдено 😢</h5>
                                            <p class="text-muted mb-0">Перевірте правильність введеного номеру ТТН <strong>@ViewBag.SearchedTTN</strong> та спробуйте ще раз.</p>
                                        </div>
                            }
                            </div>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>

<div class="container overlap-cards pb-5">
    <div class="row g-4 justify-content-center">

        <div class="col-md-4">
            <a asp-controller="City" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm hover-card">
                    <div class="card-body text-center p-5">
                        <div class="icon-wrapper">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <h4 class="card-title fw-bold">Інфраструктура</h4>
                        <p class="card-text text-muted">Керування областями, містами та мережею відділень.</p>
                        <div class="mt-4 text-danger fw-bold" style="font-size: 0.9rem;">
                            Відкрити базу <i class="bi bi-arrow-right ms-1"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Vehicle" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm hover-card">
                    <div class="card-body text-center p-5">
                        <div class="icon-wrapper">
                            <i class="bi bi-truck"></i>
                        </div>
                        <h4 class="card-title fw-bold">Автопарк</h4>
                        <p class="card-text text-muted">Контроль транспортних засобів, категорій вантажів та водіїв.</p>
                        <div class="mt-4 text-danger fw-bold" style="font-size: 0.9rem;">
                            Керувати авто <i class="bi bi-arrow-right ms-1"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Logistician" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card h-100 shadow-sm hover-card">
                    <div class="card-body text-center p-5">
                        <div class="icon-wrapper">
                            <i class="bi bi-radar"></i>
                        </div>
                        <h4 class="card-title fw-bold">Диспетчеризація</h4>
                        <p class="card-text text-muted">Моніторинг рейсів та відстеження робочого часу (Тахограф).</p>
                        <div class="mt-4 text-danger fw-bold" style="font-size: 0.9rem;">
                            Пульт логіста <i class="bi bi-arrow-right ms-1"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>