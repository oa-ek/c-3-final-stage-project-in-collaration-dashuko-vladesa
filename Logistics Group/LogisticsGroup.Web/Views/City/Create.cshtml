@model LogisticsGroup.Domain.Entities.City

@{
    ViewData["Title"] = "Додати місто";
}

<div class="container-fluid mt-4 mb-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4" style="max-width: 850px; width: 100%;">
        
        <div class="card-header bg-white border-bottom-0 pt-5 pb-3 px-4 px-md-5">
            <h3 class="fw-bold mb-1" style="color: #ed3237;">
                <i class="bi bi-building-add me-2"></i> Створити нове місто
            </h3>
            <p class="text-muted mb-0">Додайте новий населений пункт до логістичної мережі.</p>
        </div>

        <div class="card-body px-4 px-md-5 pb-5 pt-3">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="Name" class="form-label fw-bold text-dark">Назва населеного пункту <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Наприклад: Дубно" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label fw-bold text-dark">Тип <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-houses"></i></span>
                            <select asp-for="Type" class="form-select border-start-0 ps-0 fw-bold text-dark">
                                <option value="Місто" selected>Місто</option>
                                <option value="Село">Село</option>
                                <option value="СМТ">СМТ</option>
                            </select>
                        </div>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RegionId" class="form-label fw-bold text-dark">Область <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-map"></i></span>
                            <select asp-for="RegionId" class="form-select border-start-0 ps-0" asp-items="ViewBag.RegionId" required>
                                <option value="">-- Виберіть область --</option>
                            </select>
                        </div>
                        <span asp-validation-for="RegionId" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-5" style="border-color: #e9ecef;">

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3 text-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Скасувати
                    </a>
                    <button type="submit" class="btn text-white px-5 py-2 fw-bold shadow-sm rounded-3" style="background-color: #ed3237;">
                        <i class="bi bi-check2-circle me-1"></i> Зберегти місто
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}