@model IEnumerable<LogisticsGroup.Domain.Entities.City>

@{
    ViewData["Title"] = "Міста";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Список міст</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="City" asp-action="Create" class="btn btn-primary">
                Додати нове місто
            </a>
        </div>
    </div>
    <br /><br />

    <div class="row mb-4 p-3 border rounded bg-light align-items-center">
        <div class="col-md-7">
            <form asp-controller="City" asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex">
                <input type="file" name="file" class="form-control me-2" accept=".xlsx" required />
                <button type="submit" class="btn btn-success text-nowrap">📥 Імпорт з Excel</button>
            </form>
        </div>
        <div class="col-md-5 text-end">
            <a asp-controller="City" asp-action="ExportToExcel" class="btn btn-outline-success">📤 Експорт в Excel</a>
        </div>
    </div>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Тип</th>
                <th>Область</th>
                <th class="text-center">Дії</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var obj in Model)
                {
                    <tr>
                        <td width="30%">@obj.Name</td>
                        <td width="20%">@obj.Type</td>
                        <td width="30%">@(obj.Region != null ? obj.Region.Name : "Не вказано")</td>
                        
                       
                        <td width="20%" class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-controller="City" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-warning">Редагувати</a>
                                <a asp-controller="City" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger">Видалити</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">Міст поки що немає.</td></tr>
            }
        </tbody>
    </table>
</div>