@model IEnumerable<LogisticsGroup.Domain.Entities.City>

@{
    ViewData["Title"] = "Міста";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;">
            <i class="bi bi-buildings me-2"></i> Список міст
        </h2>
        <a asp-controller="City" asp-action="Create" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-plus-lg me-2"></i> Додати нове місто
        </a>
    </div>

    <div class="row mb-4 p-3 border rounded-pill bg-light align-items-center shadow-sm">
        <div class="col-md-7">
            <form asp-controller="City" asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex">
                <input type="file" name="file" class="form-control me-2" accept=".xlsx" required />
                <button type="submit" class="btn btn-success text-nowrap rounded-3">📥 Імпорт з Excel</button>
            </form>
        </div>
        <div class="col-md-5 text-end">
            <a asp-controller="City" asp-action="ExportToExcel" class="btn btn-outline-success rounded-3">📤 Експорт в Excel</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0">Назва</th>
                            <th scope="col" class="py-3 border-0">Тип населеного пункту</th>
                            <th scope="col" class="py-3 border-0">Область</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var obj in Model)
                            {
                                string typeBadgeClass = "bg-secondary";
                                if (obj.Type != null)
                                {
                                    var typeStr = obj.Type.ToString();
                                    if (typeStr.Contains("Місто")) typeBadgeClass = "bg-primary";
                                    else if (typeStr.Contains("Село") || typeStr.Contains("СМТ")) typeBadgeClass = "bg-success";
                                }

                                        <tr>
                                            <td class="ps-4 py-3 fw-bold text-dark fs-5">@obj.Name</td>

                                            <td class="py-3">
                                                <span class="badge @typeBadgeClass rounded-pill px-3 py-2 shadow-sm">
                                            @obj.Type
                                                </span>
                                            </td>

                                            <td class="py-3 text-muted">
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @(obj.Region != null ? obj.Region.Name : "Не вказано")
                                            </td>

                                            <td class="pe-4 py-3 text-end">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <a asp-controller="City" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Редагувати">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    <a asp-controller="City" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Видалити">
                                                        <i class="bi bi-trash3"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-map d-block mb-3" style="font-size: 3rem; color: #e9ecef;"></i>
                                        <h5 class="fw-bold">База міст порожня</h5>
                                    </td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>