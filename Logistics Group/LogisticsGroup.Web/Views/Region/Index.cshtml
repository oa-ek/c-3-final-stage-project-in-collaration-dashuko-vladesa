@model IEnumerable<LogisticsGroup.Domain.Entities.Region>

@{
    ViewData["Title"] = "Області";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;">
            <i class="bi bi-map-fill me-2"></i> Управління областями
        </h2>
        <a asp-controller="Region" asp-action="Create" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-plus-lg me-2"></i> Додати нову область
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0 rounded-top-start">Назва області</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end rounded-top-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var obj in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark fs-6">
                                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>@obj.Name область
                                    </td>
                                    
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="Region" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Редагувати">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Region" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Видалити">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="bi bi-map d-block mb-3" style="font-size: 3rem; color: #e9ecef;"></i>
                                    <h5 class="fw-bold">Список областей порожній</h5>
                                    <p>Натисніть кнопку "Додати нову область", щоб розпочати налаштування географії.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
