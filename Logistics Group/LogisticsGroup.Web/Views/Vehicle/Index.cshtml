@model IEnumerable<LogisticsGroup.Domain.Entities.Vehicle>

@{
    ViewData["Title"] = "Автопарк";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;">
            <i class="bi bi-truck me-2"></i> Список Транспорту
        </h2>
        <a asp-controller="Vehicle" asp-action="Create" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-plus-lg me-2"></i> Додати нову машину
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0 rounded-top-start">Марка</th>
                            <th scope="col" class="py-3 border-0">Номерний знак</th>
                            <th scope="col" class="py-3 border-0">Вантажопідйомність</th>
                            <th scope="col" class="py-3 border-0">Статус</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end rounded-top-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var obj in Model)
                            {
                                string badgeClass = "bg-secondary";
                                if (obj.Status != null)
                                {
                                    var statusStr = obj.Status.ToString();
                                    if (statusStr.Contains("Вільна")) badgeClass = "bg-success";
                                    else if (statusStr.Contains("ремонті")) badgeClass = "bg-danger";
                                    else if (statusStr.Contains("рейсі")) badgeClass = "bg-primary";
                                    else if (statusStr.Contains("завантаженні")) badgeClass = "bg-warning text-dark";
                                }

                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark">@obj.Brand</td>
                                    
                                    <td class="py-3">
                                        <span class="badge border border-secondary text-secondary bg-light px-2 py-1 fs-6" style="font-family: monospace; letter-spacing: 1px;">
                                            @obj.LicensePlate
                                        </span>
                                    </td>
                                    
                                    <td class="py-3 text-muted">@obj.Capacity т.</td>
                                    
                                    <td class="py-3">
                                        <span class="badge @badgeClass rounded-pill px-3 py-2 shadow-sm">
                                            @obj.Status
                                        </span>
                                    </td>
                                    
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Редагувати">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Vehicle" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-outline-danger rounded-3 px-2" title="Видалити">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-truck d-block mb-3" style="font-size: 3rem; color: #e9ecef;"></i>
                                    <h5 class="fw-bold">Машин поки що немає</h5>
                                    <p>Натисніть кнопку "Додати нову машину", щоб поповнити автопарк.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>