@model LogisticsGroup.Domain.Entities.Vehicle

@{
    ViewData["Title"] = "Редагувати авто";
}

<div class="container-fluid mt-4 mb-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4" style="max-width: 850px; width: 100%;">
        
        <div class="card-header bg-white border-bottom-0 pt-5 pb-3 px-4 px-md-5">
            <h3 class="fw-bold mb-1" style="color: #ed3237;">
                <i class="bi bi-pencil-square me-2"></i> Редагувати дані машини
            </h3>
            <p class="text-muted mb-0">Оновіть інформацію про транспортний засіб. Всі зміни будуть збережені в базі.</p>
        </div>

        <div class="card-body px-4 px-md-5 pb-5 pt-3">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>
                
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Brand" class="form-label fw-bold text-dark">Марка авто <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                            <input asp-for="Brand" class="form-control border-start-0 ps-0" placeholder="Наприклад: IVECO" required />
                        </div>
                        <span asp-validation-for="Brand" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LicensePlate" class="form-label fw-bold text-dark">Номерний знак <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-123"></i></span>
                            <input asp-for="LicensePlate" class="form-control border-start-0 ps-0 text-uppercase" placeholder="KA 1234 XX" required />
                        </div>
                        <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label fw-bold text-dark">Вантажопідйомність <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-box-seam"></i></span>
                            <input asp-for="Capacity" type="text" class="form-control border-start-0 border-end-0 px-0" placeholder="0.0" required />
                            <span class="input-group-text bg-light text-muted fw-bold">тонн</span>
                        </div>
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-bold text-dark">Поточний статус <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-info-circle"></i></span>
                            <select asp-for="Status" class="form-select border-start-0 ps-0 fw-bold">
                                <option value="Вільна">🟢 Вільна (Готова до рейсу)</option>
                                <option value="В ремонті">🔴 В ремонті</option>
                                <option value="На завантаженні">🟡 На завантаженні</option>
                                <option value="В рейсі">🔵 В рейсі</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-5" style="border-color: #e9ecef;">

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3 text-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Скасувати
                    </a>
                    <button type="submit" class="btn text-white px-5 py-2 fw-bold shadow-sm rounded-3" style="background-color: #198754;">
                        <i class="bi bi-arrow-clockwise me-1"></i> Оновити дані
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}