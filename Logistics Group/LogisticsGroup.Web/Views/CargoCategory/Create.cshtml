@model LogisticsGroup.Domain.Entities.CargoCategory

@{
    ViewData["Title"] = "Додати категорію";
}

<div class="container-fluid mt-4 mb-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4" style="max-width: 850px; width: 100%;">
        
        <div class="card-header bg-white border-bottom-0 pt-5 pb-3 px-4 px-md-5">
            <h3 class="fw-bold mb-1" style="color: #ed3237;">
                <i class="bi bi-box-fill me-2"></i> Створити нову категорію вантажу
            </h3>
            <p class="text-muted mb-0">Налаштуйте параметри ваги для правильного розподілу посилок.</p>
        </div>

        <div class="card-body px-4 px-md-5 pb-5 pt-3">
            <form method="post" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="Name" class="form-label fw-bold text-dark">Назва категорії <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                            <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Наприклад: Дрібні посилки" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MinWeight" class="form-label fw-bold text-dark">Мінімальна вага <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-arrow-down-circle"></i></span>
                            <input asp-for="MinWeight" type="text" class="form-control border-start-0 border-end-0 ps-0" placeholder="0.00" required />
                            <span class="input-group-text bg-light text-muted fw-bold">кг</span>
                        </div>
                        <span asp-validation-for="MinWeight" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaxWeight" class="form-label fw-bold text-dark">Максимальна вага <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-arrow-up-circle"></i></span>
                            <input asp-for="MaxWeight" type="text" class="form-control border-start-0 border-end-0 ps-0" placeholder="0.00" required />
                            <span class="input-group-text bg-light text-muted fw-bold">кг</span>
                        </div>
                        <span asp-validation-for="MaxWeight" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-5" style="border-color: #e9ecef;">

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-controller="CargoCategory" asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3 text-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Скасувати
                    </a>
                    <button type="submit" class="btn text-white px-5 py-2 fw-bold shadow-sm rounded-3" style="background-color: #ed3237;">
                        <i class="bi bi-check2-circle me-1"></i> Зберегти
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}