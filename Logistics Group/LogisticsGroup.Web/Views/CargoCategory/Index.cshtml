@model IEnumerable<LogisticsGroup.Domain.Entities.CargoCategory>

@{
    ViewData["Title"] = "Категорії вантажів";
}

<div class="container p-3">
    <div class="row pt-4 mb-3">
        <div class="col-6">
            <h2 class="text-primary">Список категорій вантажів</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="CargoCategory" asp-action="Create" class="btn btn-primary">
                Додати нову категорію
            </a>
        </div>
    </div>

    <div class="row mb-4 p-3 border rounded bg-light align-items-center">
        <div class="col-md-7">
            <form asp-controller="CargoCategory" asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex">
                <input type="file" name="file" class="form-control me-2" accept=".xlsx" required />
                <button type="submit" class="btn btn-success text-nowrap">📥 Імпорт з Excel</button>
            </form>
        </div>
        <div class="col-md-5 text-end">
            <a asp-controller="CargoCategory" asp-action="ExportToExcel" class="btn btn-outline-success">
                📤 Експорт в Excel
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Назва категорії</th>
                <th>Мін. вага (кг)</th>
                <th>Макс. вага (кг)</th>
                <th class="text-center">Дії</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var obj in Model)
                {
                            <tr>
                                <td width="30%">@obj.Name</td>
                                <td width="20%">@obj.MinWeight</td>
                                <td width="20%">@obj.MaxWeight</td>
                                <td class="text-center">
                                    <div class="w-75 btn-group" role="group">
                                        <a asp-controller="CargoCategory" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-warning mx-2">
                                            Редагувати
                                        </a>
                                        <a asp-controller="CargoCategory" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-danger mx-2">
                                            Видалити
                                        </a>
                                    </div>
                                </td>
                            </tr>
                }
            }
            else
            {
                    <tr>
                        <td colspan="4" class="text-center">Категорій поки що немає.</td>
                    </tr>
            }
        </tbody>
    </table>
</div>