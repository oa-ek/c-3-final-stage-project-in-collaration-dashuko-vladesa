@model LogisticsGroup.Domain.Entities.Flight
@{
    ViewData["Title"] = "Кабінет Водія";
}

<div class="container mt-4 mb-5" style="max-width: 600px; margin: auto;">
    <h2 class="fw-bold mb-4 text-center" style="color: #ed3237;">
        <i class="bi bi-truck me-2"></i> Мій поточний рейс
    </h2>

    @if (Model == null)
    {
            <div class="alert alert-success text-center shadow-sm rounded-4 p-5 bg-white border-0">
                <i class="bi bi-cup-hot fs-1 text-success d-block mb-3"></i>
                <h4 class="fw-bold">Немає активних рейсів</h4>
                <p class="mb-0 text-muted">Ви вільні! Очікуйте на нові призначення від логіста.</p>
            </div>
    }
    else
    {
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header text-white text-center py-3" 
                     style="background-color: @(Model.Status == "Доставлено" ? "#198754" : (Model.Status == "В дорозі" ? "#fd7e14" : "#0d6efd"));">
                    <h5 class="mb-0 fw-bold">
                        Статус рейсу: @Model.Status
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <div>
                            <small class="text-muted d-block">Номер рейсу</small>
                            <span class="fw-bold fs-5">FLT-@Model.Id</span>
                        </div>
                        <div class="text-end">
                            <small class="text-muted d-block">Відправлення</small>
                            <span class="fw-bold">@Model.DepartureDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted mb-2"><i class="bi bi-box-seam me-2"></i> Вантаж</h6>
                        <div class="bg-light p-3 rounded-3 fw-bold">
                        @(Model.Parcels?.Count ?? 0) посилок на борту
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-muted mb-2"><i class="bi bi-car-front me-2"></i> Транспорт</h6>
                        <div class="bg-light p-3 rounded-3 d-flex justify-content-between align-items-center">
                            <span>@Model.Vehicle?.Brand</span>
                            <span class="badge bg-secondary fs-6">@Model.Vehicle?.LicensePlate</span>
                        </div>
                    </div>

                    <div class="d-grid gap-3 mt-4">
                    @if (Model.Status == "Створено")
                    {
                                <form asp-action="UpdateStatus" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="newStatus" value="В дорозі" />
                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm py-3">
                                        <i class="bi bi-play-fill me-2 fs-5"></i> Виїхати (В дорозі)
                                    </button>
                                </form>
                    }
                    else if (Model.Status == "В дорозі")
                    {
                                <form asp-action="UpdateStatus" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="newStatus" value="Доставлено" />
                                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm py-3">
                                        <i class="bi bi-check-circle-fill me-2 fs-5"></i> Прибув (Доставлено)
                                    </button>
                                </form>
                    }
                    </div>
                </div>
            </div>
    }
</div>