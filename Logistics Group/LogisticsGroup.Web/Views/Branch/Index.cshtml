@model IEnumerable<LogisticsGroup.Domain.Entities.Branch>

@{
    ViewData["Title"] = "Управління Відділеннями";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;">
            <i class="bi bi-building-fill-gear me-2"></i> Список відділень
        </h2>
        <a asp-controller="Branch" asp-action="Create" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-plus-lg me-2"></i> Додати нове відділення
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0 rounded-top-start">№</th>
                            <th scope="col" class="py-3 border-0">Місто</th>
                            <th scope="col" class="py-3 border-0">Адреса</th>
                            <th scope="col" class="py-3 border-0">Тип</th>
                            <th scope="col" class="py-3 border-0">До (кг)</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end rounded-top-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var obj in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark fs-6">
                                        <i class="bi bi-building text-danger me-2"></i>@obj.Number
                                    </td>
                                    
                                    <td class="py-3 text-muted">
                                        <i class="bi bi-geo-alt-fill text-secondary me-1"></i>
                                        @(obj.City != null ? obj.City.Name : "Не вказано")
                                    </td>

                                    <td class="py-3 text-dark fw-semibold">@obj.Address</td>

                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border px-2 py-1">@obj.Type</span>
                                    </td>
                                    
                                    <td class="py-3 text-muted">@obj.MaxWeight</td>
                                    
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-controller="Branch" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Редагувати">
                                                <i class="bi bi-pencil-square"></i> Редаг.
                                            </a>
                                            <a asp-controller="Branch" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="Видалити">
                                                <i class="bi bi-trash3"></i> Видал.
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-buildings d-block mb-3" style="font-size: 3rem; color: #e9ecef;"></i>
                                    <h5 class="fw-bold">Відділення відсутні</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>