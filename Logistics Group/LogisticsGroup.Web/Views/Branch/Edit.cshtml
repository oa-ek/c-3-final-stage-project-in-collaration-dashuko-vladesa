@model LogisticsGroup.Domain.Entities.Branch

@{
    ViewData["Title"] = "Редагувати відділення";
}

<div class="container-fluid mt-4 mb-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm rounded-4" style="max-width: 900px; width: 100%;">
        
        <div class="card-header bg-white border-bottom-0 pt-5 pb-3 px-4 px-md-5">
            <h3 class="fw-bold mb-1" style="color: #ed3237;">
                <i class="bi bi-pencil-square me-2"></i> Редагувати дані відділення
            </h3>
        </div>

        <div class="card-body px-4 px-md-5 pb-5 pt-3">
            <form method="post" asp-action="Edit">
                
                <input type="hidden" asp-for="Id" />

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="CityId" class="form-label fw-bold text-dark">Місто <span class="text-danger">*</span></label>
                        <select asp-for="CityId" class="form-select form-select-lg shadow-sm rounded-3" asp-items="ViewBag.CityId" required></select>
                        <span asp-validation-for="CityId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Number" class="form-label fw-bold text-dark">Номер відділення (напр. 1, 15) <span class="text-danger">*</span></label>
                        <input asp-for="Number" class="form-control form-control-lg shadow-sm rounded-3" required />
                        <span asp-validation-for="Number" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-bold text-dark">Адреса <span class="text-danger">*</span></label>
                        <input asp-for="Address" class="form-control form-control-lg shadow-sm rounded-3" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Type" class="form-label fw-bold text-dark">Тип (напр. Вантажне, Поштове)</label>
                        <input asp-for="Type" class="form-control form-control-lg shadow-sm rounded-3" />
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WorkingHours" class="form-label fw-bold text-dark">Години роботи (необов'язково)</label>
                        <input asp-for="WorkingHours" class="form-control form-control-lg shadow-sm rounded-3" />
                        <span asp-validation-for="WorkingHours" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaxWeight" class="form-label fw-bold text-dark">Максимальна вага в кг (необов'язково)</label>
                        <input asp-for="MaxWeight" type="text" class="form-control form-control-lg shadow-sm rounded-3" />
                        <span asp-validation-for="MaxWeight" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-5" style="border-color: #e9ecef;">

                <div class="d-flex gap-3 justify-content-end">
                    <button type="submit" class="btn text-white px-5 py-2 fw-bold shadow-sm rounded-3" style="background-color: #198754;">
                        Оновити
                    </button>
                    <a asp-controller="Branch" asp-action="Index" class="btn btn-secondary px-4 py-2 fw-bold rounded-3 shadow-sm">
                        Скасувати
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}