@{
    ViewData["Title"] = "Відновлення паролю";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-lg mt-5">
            <div class="card-header bg-danger text-white text-center">
                <h3 class="font-weight-light my-2">Відновлення паролю</h3>
            </div>
            <div class="card-body">
                <div class="small mb-3 text-muted">
                    Введіть вашу електронну адресу, і ми надішлемо вам посилання для скидання паролю.
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="form-floating mb-3">
                        <input name="email" type="email" class="form-control" id="inputEmail" placeholder="name@example.com" required />
                        <label for="inputEmail">Електронна пошта</label>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                        <a class="small text-danger" asp-controller="Account" asp-action="Login">Повернутися до входу</a>
                        <button type="submit" class="btn btn-danger px-4">Відправити лист</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>