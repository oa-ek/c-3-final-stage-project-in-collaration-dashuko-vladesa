@model LogisticsGroup.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Вхід у систему";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-lg mt-5">
            <div class="card-header bg-danger text-white text-center">
                <h3 class="font-weight-light my-2">Авторизація</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" id="inputEmail" placeholder="name@example.com" />
                        <label asp-for="Email">Електронна пошта</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" id="inputPassword" placeholder="Password" />
                        <label asp-for="Password">Пароль</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="RememberMe" id="rememberPasswordCheck" />
                        <label class="form-check-label" for="rememberPasswordCheck">
                            Запам'ятати мене
                        </label>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                        <a class="small text-danger" href="#">Забули пароль?</a>
                        <button type="submit" class="btn btn-danger px-4">Увійти</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}