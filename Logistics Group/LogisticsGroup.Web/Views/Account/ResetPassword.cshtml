@model LogisticsGroup.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Скидання паролю";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-header bg-danger text-white text-center">
                <h3 class="font-weight-light my-2">Новий пароль</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <input asp-for="Code" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <label asp-for="Email">Електронна пошта</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Новий пароль" />
                        <label asp-for="Password">Новий пароль</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторіть пароль" />
                        <label asp-for="ConfirmPassword">Повторіть пароль</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Зберегти пароль</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}