@{
    ViewData["Title"] = "Панель водія";
}

<style>
    .driver-dashboard {
        background-color: #f8f9fa;
        min-height: 80vh;
        padding-bottom: 2rem;
    }
    .weather-widget {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        border-radius: 20px;
        box-shadow: 0 10px 20px rgba(0, 242, 254, 0.2);
    }
    .route-card {
        border-left: 5px solid #ed3237;
        border-radius: 15px;
    }
    .action-btn {
        border-radius: 15px;
        padding: 1.5rem;
        transition: transform 0.2s;
    }
    .action-btn:hover {
        transform: translateY(-5px);
    }
</style>

<div class="driver-dashboard pt-4">
    <div class="container max-w-md">
        
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success shadow-sm rounded-4 mb-4">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["success"]
            </div>
        }
        @if (TempData["info"] != null)
        {
            <div class="alert alert-info shadow-sm rounded-4 mb-4">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["info"]
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Привіт, Водію! 🚚</h2>
                <p class="text-muted mb-0">Твій поточний статус та рейс</p>
            </div>
            <div class="bg-white p-2 rounded-circle shadow-sm">
                <i class="bi bi-person-circle fs-1 text-danger"></i>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm route-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="badge bg-danger rounded-pill px-3 py-2">Активний рейс #4092</span>
                            <span class="text-muted fw-bold">Сьогодні</span>
                        </div>
                        <h4 class="fw-bold">Точка прибуття: @ViewBag.DestinationCity</h4>
                        <p class="text-muted fs-5"><i class="bi bi-geo-alt-fill text-danger me-2"></i>@ViewBag.DestinationAddress</p>
                        
                        <div class="d-flex gap-2 mt-4">
                            <form asp-action="StartTrip" method="post" class="w-50">
                                <input type="hidden" name="tripId" value="4092" />
                                <button type="submit" class="btn btn-dark w-100 rounded-pill fw-bold py-2">
                                    <i class="bi bi-play-fill me-1"></i> Почати
                                </button>
                            </form>
                            <form asp-action="FinishTrip" method="post" class="w-50">
                                <input type="hidden" name="tripId" value="4092" />
                                <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold py-2">
                                    <i class="bi bi-stop-fill me-1"></i> Завершити
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 weather-widget h-100 p-4 text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase fw-bold opacity-75 mb-3">Погода в точці прибуття</h6>
                    
                    @if (ViewBag.WeatherTemp != null)
                    {
                        <h1 class="display-2 fw-bolder mb-0">@ViewBag.WeatherTemp°C</h1>
                        <h4 class="mt-2">@ViewBag.WeatherDesc</h4>
                        <p class="mt-3 mb-0 opacity-75 small">
                            <i class="bi bi-cloud-check me-1"></i> Дані з Open-Meteo API
                        </p>
                    }
                    else
                    {
                        <div class="py-4">
                            <i class="bi bi-wifi-off fs-1 mb-2 d-block"></i>
                            <h5>@ViewBag.WeatherDesc</h5>
                        </div>
                    }
                </div>
            </div>
        </div>

        <h5 class="fw-bold mt-5 mb-3">Швидкі дії</h5>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a asp-action="ReportFuel" class="btn btn-white w-100 shadow-sm action-btn border-0 text-dark d-flex flex-column align-items-center">
                    <i class="bi bi-fuel-pump text-danger fs-2 mb-2"></i>
                    <span class="fw-bold">Пальне</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-action="ContactDispatcher" class="btn btn-white w-100 shadow-sm action-btn border-0 text-dark d-flex flex-column align-items-center">
                    <i class="bi bi-headset text-primary fs-2 mb-2"></i>
                    <span class="fw-bold">Диспетчер</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <button class="btn btn-white w-100 shadow-sm action-btn border-0 text-dark d-flex flex-column align-items-center">
                    <i class="bi bi-map text-success fs-2 mb-2"></i>
                    <span class="fw-bold">Маршрут</span>
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button class="btn btn-white w-100 shadow-sm action-btn border-0 text-dark d-flex flex-column align-items-center">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-2"></i>
                    <span class="fw-bold">Поломка</span>
                </button>
            </div>
        </div>

    </div>
</div>