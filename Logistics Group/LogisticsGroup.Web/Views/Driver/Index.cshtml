@model IEnumerable<LogisticsGroup.Domain.Entities.Driver>

@{
    ViewData["Title"] = "Керування Водіями";
}

<div class="container-fluid mt-4 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 mb-4 fs-5" role="alert" style="background-color: #d1e7dd; border-left: 5px solid #0f5132;">
            <i class="bi bi-key-fill me-2 fs-4 text-success"></i>
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-4 fs-5" role="alert" style="border-left: 5px solid #842029;">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4 text-danger"></i>
            <strong>@TempData["ErrorMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;">
            <i class="bi bi-person-vcard me-2"></i> Список Водіїв
        </h2>
        <a asp-controller="Driver" asp-action="Create" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-person-plus me-2"></i> Додати водія
        </a>
    </div>

    @* Блок Імпорту/Експорту *@
    <div class="row mb-4 p-3 border rounded-pill bg-light align-items-center shadow-sm">
        <div class="col-md-7">
            <form asp-controller="Driver" asp-action="ImportFromExcel" method="post" enctype="multipart/form-data" class="d-flex">
                <input type="file" name="file" class="form-control me-2" accept=".xlsx" required />
                <button type="submit" class="btn btn-success text-nowrap rounded-3">📥 Імпорт з Excel</button>
            </form>
        </div>
        <div class="col-md-5 text-end">
            <a asp-controller="Driver" asp-action="ExportToExcel" class="btn btn-outline-success rounded-3">📤 Експорт в Excel</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0">ПІБ водія</th>
                            <th scope="col" class="py-3 border-0">Телефон / Контакти</th>
                            <th scope="col" class="py-3 border-0">Статус</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var obj in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-dark fs-5">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3 text-secondary border" style="width: 45px; height: 45px;">
                                                <i class="bi bi-person-fill fs-4"></i>
                                            </div>
                                            @obj.FullName
                                        </div>
                                    </td>

                                    <td class="py-3 text-muted">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-telephone-fill me-2" style="color: #ed3237;"></i>
                                            <span class="fw-semibold">@obj.Phone</span>
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (string.IsNullOrEmpty(obj.Status) || obj.Status.Contains("Вільн"))
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i> @(obj.Status ?? "Вільний")
                                            </span>
                                        }
                                        else if (obj.Status.Contains("рейс"))
                                        {
                                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                                <i class="bi bi-truck me-1"></i> @obj.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@obj.Status</span>
                                        }
                                    </td>

                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2 align-items-center">
                                            
                                            <form asp-action="ResetPassword" asp-route-id="@obj.Id" method="post" onsubmit="return confirm('Ви впевнені, що хочете скинути пароль для водія @obj.FullName?');">
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-3 px-2 shadow-sm" title="Скинути пароль">
                                                    <i class="bi bi-key-fill"></i>
                                                </button>
                                            </form>

                                            <a asp-controller="Driver" asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary rounded-3 px-2 shadow-sm" title="Редагувати">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Driver" asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger rounded-3 px-2 shadow-sm" title="Видалити">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people d-block mb-3" style="font-size: 3rem; color: #e9ecef;"></i>
                                    <h5 class="fw-bold">Штат водіїв порожній</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>