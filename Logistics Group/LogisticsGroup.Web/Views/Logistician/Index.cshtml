@model IEnumerable<LogisticsGroup.Domain.Entities.Flight>
@{
    ViewData["Title"] = "Панель управління логіста";
    var logisticianName = User.Identity?.Name ?? "Логіст";
}

<div class="container-fluid mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0" style="color: #ed3237;">
                <i class="bi bi-speedometer2 me-2"></i> Центр управління логістикою
            </h2>
            <p class="text-muted mt-1 mb-0">З поверненням, @logisticianName! Ось реальний звіт на сьогодні.</p>
        </div>
        <a asp-controller="Parcel" asp-action="Index" class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-box-seam me-2"></i> Перейти на склад (Створити рейс)
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(135deg, #198754 0%, #20c997 100%); color: white;">
                <div class="card-body p-4 position-relative overflow-hidden">
                    <i class="bi bi-truck position-absolute opacity-25" style="font-size: 6rem; right: -10px; bottom: -20px;"></i>
                    <h6 class="fw-bold text-uppercase mb-2">Рейсів в дорозі</h6>
                    <h2 class="fw-bolder display-5 mb-0">@(ViewBag.ActiveFlightsCount ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted fw-bold text-uppercase mb-0">Вільні водії</h6>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-check-fill text-primary fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bolder text-dark mb-0">@(ViewBag.FreeDriversCount ?? 0)</h2>
                    <p class="text-success mb-0 mt-2 small fw-bold"><i class="bi bi-check-circle me-1"></i> Готові до відправки</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted fw-bold text-uppercase mb-0">На складах</h6>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-boxes text-warning fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bolder text-dark mb-0">@(ViewBag.ParcelsInWarehouseCount ?? 0)</h2>
                    <p class="text-warning mb-0 mt-2 small fw-bold"><i class="bi bi-clock-history me-1"></i> Посилок очікує відправки</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted fw-bold text-uppercase mb-0">На СТО</h6>
                        <div class="bg-light rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-tools text-danger fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bolder text-dark mb-0">@(ViewBag.VehiclesInRepairCount ?? 0)</h2>
                    <p class="text-danger mb-0 mt-2 small fw-bold"><i class="bi bi-exclamation-triangle me-1"></i> Авто в ремонті</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-danger me-2"></i> Моніторинг активних рейсів</h5>
            <button onclick="location.reload();" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold"><i class="bi bi-arrow-clockwise"></i> Оновити</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="ps-4 py-3 border-0">Номер рейсу</th>
                            <th scope="col" class="py-3 border-0">Водій</th>
                            <th scope="col" class="py-3 border-0">Транспорт</th>
                            <th scope="col" class="py-3 border-0">Посилок</th>
                            <th scope="col" class="py-3 border-0">Статус</th>
                            <th scope="col" class="pe-4 py-3 border-0 text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var flight in Model)
                            {
                                        <tr>
                                            <td class="ps-4 py-3 fw-bold text-dark">FLT-@flight.Id</td>

                                            <td class="py-3 fw-semibold">
                                                <i class="bi bi-person-badge text-muted me-1"></i> @flight.Driver?.FullName
                                            </td>

                                            <td class="py-3">
                                                <span class="text-primary fw-bold">@flight.Vehicle?.LicensePlate</span>
                                            </td>

                                            <td class="py-3 text-muted">
                                                <i class="bi bi-box me-1"></i> @flight.Parcels?.Count шт.
                                            </td>

                                            <td class="py-3">
                                                <span class="badge bg-success rounded-pill px-3 py-2 shadow-sm">
                                                    <i class="bi bi-play-circle me-1"></i> @flight.Status
                                                </span>
                                            </td>

                                            <td class="pe-4 py-3 text-end">
                                                <a asp-controller="Flight" asp-action="Details" asp-route-id="@flight.Id" class="btn btn-sm btn-outline-primary rounded-3 px-3 fw-bold">Деталі</a>
                                            </td>
                                        </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                        <h5 class="fw-bold">Немає активних рейсів</h5>
                                        <p class="mb-0">Натисніть "Перейти на склад", щоб сформувати перший маршрут.</p>
                                    </td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>