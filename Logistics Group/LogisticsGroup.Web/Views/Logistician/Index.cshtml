@{
    ViewData["Title"] = "Пульт Логіста";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #ed3237;"><i class="bi bi-radar"></i> Пульт Логіста</h2>
        <button class="btn text-white fw-bold shadow-sm px-4 py-2" style="background-color: #ed3237; border-radius: 12px;">
            <i class="bi bi-plus-lg me-2"></i> Створити новий рейс
        </button>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-danger border-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1 small text-uppercase fw-bold">Активні рейси</p>
                    <h2 class="mb-0 fw-bolder">12</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-success border-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1 small text-uppercase fw-bold">Вільні фури</p>
                    <h2 class="mb-0 fw-bolder">5</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-warning border-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1 small text-uppercase fw-bold">На митниці / Завантаженні</p>
                    <h2 class="mb-0 fw-bolder">3</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 border-start border-info border-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1 small text-uppercase fw-bold">Водіїв у резерві</p>
                    <h2 class="mb-0 fw-bolder">8</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
            <h5 class="fw-bold mb-0">Моніторинг поточних рейсів</h5>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th scope="col" class="rounded-start">Рейс #</th>
                            <th scope="col">Маршрут</th>
                            <th scope="col">Водій</th>
                            <th scope="col">Транспорт</th>
                            <th scope="col">Статус (Тахограф)</th>
                            <th scope="col" class="text-end rounded-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">TRP-001</td>
                            <td>Київ <i class="bi bi-arrow-right text-danger mx-1"></i> Львів</td>
                            <td>Іваненко П.</td>
                            <td>IVECO (KA4581MK)</td>
                            <td><span class="badge bg-success rounded-pill px-3 py-2">В дорозі</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary rounded-3"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">TRP-002</td>
                            <td>Рівне <i class="bi bi-arrow-right text-danger mx-1"></i> Одеса</td>
                            <td>Дарина І.</td>
                            <td>MAN (BK5500CX)</td>
                            <td><span class="badge bg-warning text-dark rounded-pill px-3 py-2">На митниці</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary rounded-3"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">TRP-003</td>
                            <td>Костопіль <i class="bi bi-arrow-right text-danger mx-1"></i> Дніпро</td>
                            <td>Влада П.</td>
                            <td>Mercedes (AA1290TI)</td>
                            <td><span class="badge bg-secondary rounded-pill px-3 py-2">Відпочинок</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary rounded-3"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>