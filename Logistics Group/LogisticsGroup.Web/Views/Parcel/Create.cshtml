@model LogisticsGroup.Domain.Entities.Parcel
@{
    ViewData["Title"] = "Додати посилку";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; padding: 7px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="text-danger fw-bold mb-0">Створення нової посилки</h2>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Категорія вантажу</label>
                            <select asp-for="CategoryId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.Categories" required>
                                <option value="">Оберіть категорію...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Вага (кг)</label>
                            <input asp-for="Weight" type="number" step="0.1" min="0.1" class="form-control form-control-lg bg-light border-0" placeholder="Наприклад: 14.5" required />
                        </div>
                    </div>

                    <hr class="text-muted my-4">

                    <div class="mb-4">
                        <label class="form-label fw-bold text-danger small text-uppercase"><i class="bi bi-geo-alt-fill me-1"></i> Відділення відправника (Звідки)</label>
                        <select asp-for="SenderBranchId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.Branches" required>
                            <option value="">Оберіть відділення...</option>
                        </select>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-bold text-success small text-uppercase"><i class="bi bi-geo-alt-fill me-1"></i> Відділення отримувача (Куди)</label>
                        <select asp-for="ReceiverBranchId" class="form-select form-select-lg bg-light border-0" asp-items="ViewBag.Branches" required>
                            <option value="">Оберіть відділення...</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold shadow-sm">
                            Згенерувати ТТН та Зберегти
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>